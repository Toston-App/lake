# =============================================================================
# Local development env. Copy to `.env` (`cp .env.develop .env`) and fill in
# the blanks. docker-compose loads `.env` into every service (backend, db,
# pgadmin, backup), and the backend reads it via app/core/config.py.
#
# (required) = the backend refuses to start without a non-empty value.
# =============================================================================

# ---------- Docker / host ----------
# Hostname the backend is served from; dev compose builds SERVER_HOST=http://$DOMAIN
DOMAIN=localhost
# Name given to the built backend image (backend, prestart, export-worker)
DOCKER_IMAGE_BACKEND=backend
# IP that pgAdmin's port 5050 binds to in prod (the server's Tailscale IP, from
# `tailscale ip -4`). For local dev 127.0.0.1 is fine.
TAILSCALE_IP=127.0.0.1
# Tag sent with Axiom logs; the backend defaults to "production" when unset
# Unset means production (fail closed): Polar must be the production server
# when subscriptions are on, and paid dev tiers are never granted.
ENVIRONMENT=development
# Extra CORS origins on top of the built-in allow-list (comma-separated).
# "*" is rejected because requests carry credentials.
BACKEND_CORS_ORIGINS=

# ---------- App ----------
# Used as the API docs title and Axiom service name (required)
PROJECT_NAME=Toston
# Admin account created on first start by the prestart script (required)
FIRST_SUPERUSER=admin@toston.com
FIRST_SUPERUSER_PASSWORD=root
# Gates POST /users/open, which creates users for BOTH email/password signups
# and first-time Clerk logins. If false, nobody new can sign up.
USERS_OPEN_REGISTRATION=TRUE
# HTTP basic-auth login that protects /docs and /redoc
DOCS_USER=admin
DOCS_PASSWORD=root
# Log every SQL query with its timing (noisy, only for debugging slow queries)
PROFILE_QUERY_MODE=False

# ---------- Auth & secrets ----------
# Signs our own email/password access tokens (HS256).
# (required) Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
LOCAL_JWT_SECRET=
# Clerk JWT verification (required). All three come from the Clerk dashboard:
#   CLERK_JWT_PUBLIC_KEY:     API Keys -> "JWT public key" PEM, base64-encoded
#                             (`base64 -w0 key.pem`)
#   CLERK_ISSUER:             full issuer URL, e.g. https://your-app.clerk.accounts.dev
#   CLERK_AUTHORIZED_PARTIES: comma-separated frontend origins allowed in the
#                             token's `azp` claim, e.g. http://localhost:5173
CLERK_JWT_PUBLIC_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
# Server-side Clerk Backend API key (sk_test_... or sk_live_...). Required to
# retrieve email/name for UUID-only Clerk users during Polar customer creation.
CLERK_SECRET_KEY=
# Fernet key for encrypting sensitive fields at rest (required). Changing it
# makes existing encrypted data unreadable. Generate with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=encryption_key_sha256_and_fernet

# ---------- Postgres ----------
# Read by both the postgres container and the backend. POSTGRES_SERVER is the
# compose service name.
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=app

# ---------- pgAdmin (http://localhost:5050) ----------
# Read by the pgadmin container itself; this is the pgAdmin web login
PGADMIN_LISTEN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@toston.com
PGADMIN_DEFAULT_PASSWORD=root



# ---------- Redis (required) ----------
# Upstash REST endpoint + token (Upstash console -> your database -> REST API)
REDIS_URL=https://foo.upstash.io
REDIS_TOKEN=token

# ---------- AI ----------
# Used for receipt OCR (/ai endpoints). https://platform.openai.com/api-keys (required)
OPENAI_API_KEY=sk-proj-...
# Parses WhatsApp messages into transactions. https://openrouter.ai/keys (required)
OPENROUTER_API_KEY=key
# Primary model, plus comma-separated fallbacks tried in order if it fails
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-sonnet,gryphe/mythomax-l2-13b
# Sent as HTTP-Referer / X-Title so the app shows up in OpenRouter's rankings
OPENROUTER_SITE_URL=https://my.app
OPENROUTER_APP_NAME=TostonApp

# ---------- WhatsApp Cloud API (Meta) ----------
# All from developers.facebook.com -> your app. WhatsApp is enabled only when
# ACCESS_TOKEN, PHONE_NUMBER_ID and VERIFY_TOKEN are all set.
#   ACCESS_TOKEN:    WhatsApp -> API Setup (temporary) or a System User token
#                    from Business Settings (permanent) (required, any value in dev)
#   PHONE_NUMBER_ID: WhatsApp -> API Setup -> "Phone number ID" (use the dev number locally)
#   VERIFY_TOKEN:    any string you choose; paste the same one into
#                    WhatsApp -> Configuration -> Webhook "Verify token"
#   APP_SECRET:      App settings -> Basic -> "App secret". Verifies the
#                    X-Hub-Signature-256 header; webhooks are rejected while unset.
WHATSAPP_ACCESS_TOKEN=whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=whatsapp_verify_token
WHATSAPP_APP_SECRET=whatsapp_app_secret
WHATSAPP_API_VERSION=v22.0

# ---------- Feedback bot (required) ----------
# In-app feedback is forwarded to this Telegram chat.
#   BOT_TOKEN: from @BotFather (/newbot)
#   OWNER_ID:  your chat id (message @userinfobot to get it)
TELEGRAM_BOT_TOKEN=bot:token
TELEGRAM_OWNER_ID=chatid

# ---------- Investments feature (optional) ----------
# Feature flag. When enabled, investments are a paid-only feature (see
# docs/POLAR_SUBSCRIPTIONS.md); lapsed subscribers keep read-only access.
INVESTMENTS_ENABLED=False

# ---------- Polar.sh subscriptions & chat ----------
# Master switch. Explicit false disables even if a token is set.
# Unset/empty auto-enables when POLAR_ACCESS_TOKEN is present.
# Leave false for local dev (everyone gets SUBSCRIPTIONS_DEV_DEFAULT_TIER).
SUBSCRIPTIONS_ENABLED=false
# Polar access token (org-scoped). Create one in the Polar dashboard.
POLAR_ACCESS_TOKEN=
# Webhook secret from the Polar webhook endpoint you create.
POLAR_WEBHOOK_SECRET=
# Polar organization id.
POLAR_ORGANIZATION_ID=
# "sandbox" (api.sandbox.polar.sh) or "production" (api.polar.sh).
# production forces SUBSCRIPTIONS_DEV_DEFAULT_TIER=free (fail-closed), and
# ENVIRONMENT=production refuses to start with sandbox + subscriptions on.
POLAR_SERVER=sandbox
# Tier granted to everyone when subscriptions are disabled (dev only).
SUBSCRIPTIONS_DEV_DEFAULT_TIER=tier2
# Public base URL of this backend, for Polar checkout success_url.
# Leave blank to fall back to SERVER_HOST.
POLAR_SUCCESS_URL_BASE=
# Polar product ids per paying tier. Create the products in the Polar
# dashboard and paste their ids here. Required to actually create checkouts.
POLAR_PRODUCT_TIER1_ID=
POLAR_PRODUCT_TIER2_ID=
# Maximum accepted raw webhook payload (256 KiB).
POLAR_WEBHOOK_MAX_BYTES=262144
# Paid access lapses this long after current_period_end without a renewal
# webhook, so missed webhooks can't grant access forever.
SUBSCRIPTION_RENEWAL_GRACE_HOURS=72
# In-progress turns older than this no longer count as a message.
CHAT_TURN_RESERVATION_TTL_SECONDS=900
# Per-turn cost ceilings. After CHAT_MAX_TOOL_ROUNDS tool rounds or
# CHAT_MAX_TOKENS_PER_TURN tokens across the turn, the next model call must
# answer without tools (the budget is exceeded by at most that call).
# CHAT_MAX_OUTPUT_TOKENS caps a single response.
CHAT_MAX_TOOL_ROUNDS=8
CHAT_MAX_TOKENS_PER_TURN=200000
CHAT_MAX_OUTPUT_TOKENS=8192
# Per-user POST /chat limits (0 disables a window). Over the limit -> 429.
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=300
# Chat models (OpenRouter "provider/model" ids). Free and Basic use CHAT_MODEL;
# Premium uses CHAT_PREMIUM_MODEL, or CHAT_MODEL when it's empty.
CHAT_MODEL=openai/gpt-6-luna
CHAT_PREMIUM_MODEL=
# https://www.tavily.com/ API KEY for web search. Optional; leave empty to disable web search.
TAVILY_API_KEY=

# ---------- Axiom logging (optional) ----------
# Logging turns on automatically when AXIOM_API_TOKEN is set. Token and dataset
# from app.axiom.co -> Settings -> API tokens / Datasets. See AXIOM_README.md.
AXIOM_API_TOKEN=
AXIOM_DATASET=toston_logs
# Fraction of successful requests logged (errors and slow requests always are)
AXIOM_SAMPLE_RATE=0.05
# Requests slower than this (ms) are always logged as slow
AXIOM_SLOW_REQUEST_THRESHOLD_MS=2000

# ---------- User data exports -> Cloudflare R2 ----------
# Private bucket (different from the backup one below) where the export worker
# uploads users' data exports. Cloudflare dashboard -> R2 -> Manage API tokens
# (Object Read & Write). Endpoint is <account_id>.r2.cloudflarestorage.com.
R2_ACCESS_KEY_ID=your_export_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_export_r2_secret_access_key
R2_ENDPOINT=your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
# Folder (key prefix) inside the bucket
R2_PATH=toston-user-exports
R2_REGION=auto
# Days before an export file is deleted
EXPORT_RETENTION_DAYS=30

# ---------- Database backups (backup container) ----------
# These are read by the offen/docker-volume-backup image, so the names are
# fixed by that image. See BACKUP_README.md.
# Telegram alert URL (shoutrrr format): telegram://<bot_token>@telegram/?chats=<chat_id>
TELEGRAM_NOTIFICATION_URL=telegram://bot_token@telegram/?chats=chat_id
# When to notify: "error" (failures only) or "info" (every run)
BACKUP_NOTIFICATION_LEVEL=error
# Daily at 04:00 (container time, UTC)
BACKUP_CRON_EXPRESSION=0 4 * * *
BACKUP_FILENAME=postgres-backup-%Y-%m-%dT%H-%M-%S.tar.gz
BACKUP_RETENTION_DAYS=30
# Only files starting with this prefix are pruned
BACKUP_PRUNING_PREFIX=postgres-backup-
# Containers with this label (the db) are stopped while the backup runs
BACKUP_STOP_DURING_BACKUP_LABEL=docker-volume-backup.stop-during-backup
# Upload target: a Cloudflare R2 bucket via its S3-compatible API. The AWS_*
# names are what the backup image expects; the values are R2 credentials
# (Cloudflare dashboard -> R2 -> Manage API tokens). Endpoint has no https://.
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
AWS_ENDPOINT=your_account_id.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=your_backup_bucket_name
AWS_DEFAULT_REGION=auto
# Folder (key prefix) inside the bucket
AWS_S3_PATH=postgres-backups/
# Optional: encrypt archives with this GPG passphrase (see the image's docs
# for more options: https://offen.github.io/docker-volume-backup/reference/)
# GPG_PASSPHRASE=
